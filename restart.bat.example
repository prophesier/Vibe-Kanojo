@echo off
REM ============================================================================
REM Auto-restart script triggered by Discord bot /restart or /resume command.
REM
REM Reads PID files from pids/, kills OLV + Discord bot, then re-launches both
REM services in separate command windows. TTS (which runs out of a separate
REM project) is intentionally NOT touched.
REM
REM Optional argument:
REM   restart.bat --resume
REM passes --resume to run_server.py, continuing the previous conversation
REM session instead of opening a new one.
REM
REM EDIT THE LINE BELOW to match your conda environment name.
REM ============================================================================

setlocal enabledelayedexpansion
cd /d "%~dp0"

REM === EDIT THESE ===
REM This file is generated from restart.bat.example on first run and is
REM gitignored, so edit it freely - your changes won't be tracked.
set "CONDA_ENV="
REM ==================

REM Strip the trailing backslash so START /D receives a clean project path.
set "PROJECT_DIR=%~dp0"
if "%PROJECT_DIR:~-1%"=="\" set "PROJECT_DIR=%PROJECT_DIR:~0,-1%"

set "OLV_ARGS="
REM Make /restart unambiguously fresh even if the parent shell had this set.
set "OLV_RESUME="
set "RESTART_MODE=fresh"
if /I "%~1"=="--resume" (
    set "OLV_ARGS=--resume"
    set "RESTART_MODE=resume"
)

echo Restart mode: %RESTART_MODE%
echo Waiting for services to exit cleanly...
timeout /t 3 /nobreak >nul

if exist pids\olv.pid (
    set /p OLV_PID=<pids\olv.pid
    if defined OLV_PID (
        echo Killing OLV PID !OLV_PID!...
        taskkill /F /PID !OLV_PID! 2>nul
    )
    del /f /q pids\olv.pid 2>nul
)

if exist pids\discord.pid (
    set /p BOT_PID=<pids\discord.pid
    if defined BOT_PID (
        echo Killing Discord bot PID !BOT_PID!...
        taskkill /F /PID !BOT_PID! 2>nul
    )
    del /f /q pids\discord.pid 2>nul
)

echo Re-launching OLV and Discord bot from local code...
start "OLV" /D "%PROJECT_DIR%" cmd /c "call conda activate %CONDA_ENV% && python run_server.py %OLV_ARGS%"
start "Discord" /D "%PROJECT_DIR%" cmd /c "timeout /t 15 /nobreak >nul && call conda activate %CONDA_ENV% && python scripts\run_discord_bot.py"

endlocal
exit /b 0
